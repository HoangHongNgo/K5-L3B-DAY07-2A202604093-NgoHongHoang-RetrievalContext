# Copy to starter/.env and set your local PostgreSQL credentials.
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:55433/day6_lab
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Pinned low-cost DeepSeek model on OpenRouter; supports tools and tool_choice.
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=deepseek/deepseek-v4-flash-0731
# Set OPENROUTER_API_KEY locally. Never commit the key.
